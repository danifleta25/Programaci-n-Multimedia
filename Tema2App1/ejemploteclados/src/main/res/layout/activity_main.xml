<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. Teclado de teléfono (*, +, #) -->
    <EditText
        android:id="@+id/etTelefono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Teclado teléfono (phone)"
        android:inputType="phone" />

    <!-- 2. Teclado numérico con decimales (.) -->
    <EditText
        android:id="@+id/etDecimal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Teclado decimal (numberDecimal)"
        android:inputType="numberDecimal" />

    <!-- 3. Teclado correo electrónico (@ y .com) -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Teclado email (textEmailAddress)"
        android:inputType="textEmailAddress" />

    <!-- 4. Teclado numérico puro (0-9) -->
    <EditText
        android:id="@+id/etNumerico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Teclado numérico (numberPassword)"
        android:inputType="numberPassword" />

</LinearLayout>